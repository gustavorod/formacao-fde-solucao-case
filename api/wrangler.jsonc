{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formacao-fde-solucao-case-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "observability": { "enabled": true },
  // A tela (web/, #60). O Worker roda antes de qualquer arquivo, então o Cloudflare Access vale
  // também para o index.html e os assets. Caminho de tela desconhecido devolve o index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // #41 O Workers AI, por onde o motor de decisão chama o Clef (épico #149, AC-6). É um binding, sem chave:
  // o `wrangler deploy` da esteira já o publica a partir deste arquivo.
  "ai": { "binding": "ai" },
  "triggers": {
    // O Cron roda a cada 15 minutos e, por enquanto, só registra que rodou.
    "crons": ["*/15 * * * *"]
  }
  // Segredos (BARTE_ACADEMY_*) não ficam aqui: em produção, `wrangler secret put`;
  // localmente, no `.dev.vars`, que o git ignora.
}
